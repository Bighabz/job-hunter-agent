[Unit]
Description=Read the matching code for an authorized job application
After=network-online.target

[Service]
Type=oneshot
User=jobhunter
WorkingDirectory=/opt/job-hunter/deploy/job-autopilot
Environment=PATH=/home/jobhunter/.local/bin:/opt/job-hunter/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/opt/job-hunter/.venv/bin/python /opt/job-hunter/deploy/email-verification/scripts/collect_code.py
TimeoutStartSec=175
KillMode=control-group
