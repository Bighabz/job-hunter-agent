[Unit]
Description=External employer application batch; confirmed daily target100
OnFailure=alert@%n.service
After=chrome.service
Requires=chrome.service
[Service]
Type=oneshot
Environment=HOME=/root
Environment=DISPLAY=:99
WorkingDirectory=/opt/job-hunter/deploy/job-autopilot
ExecStart=/usr/bin/bash /opt/job-hunter/deploy/job-autopilot/run.sh
TimeoutStartSec=3600
