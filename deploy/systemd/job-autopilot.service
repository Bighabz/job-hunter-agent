[Unit]
Description=Job Hunter application batch
After=network-online.target

[Service]
Type=oneshot
User=jobhunter
WorkingDirectory=/opt/job-hunter
Environment=DISPLAY=:99
Environment=JOBHUNT_PYTHON=/opt/job-hunter/.venv/bin/python
Environment=PATH=/home/jobhunter/.local/bin:/opt/job-hunter/.venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/usr/bin/bash /opt/job-hunter/deploy/job-autopilot/run.sh
TimeoutStartSec=3600
